{
  "name": "@uxq/playground",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive UXQ evaluation strategy playground",
  "bin": {
    "uxq-playground": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap",
    "dev": "tsup src/index.ts --format esm --dts --sourcemap --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@uxq/core": "workspace:*",
    "@uxq/contracts": "workspace:*",
    "@uxq/scoring": "workspace:*",
    "@uxq/rules": "workspace:*",
    "@uxq/metrics": "workspace:*",
    "@uxq/diagnostic": "workspace:*",
    "commander": "^13.0.0",
    "chalk": "^5.4.1"
  }
}
