{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uxq.dev/schemas/common/identifier/1.0.0",
  "title": "UXQ Identifier",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "format": "uxq-id"
    },
    "Version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "type": "object",
  "description": "Container for Id, Version, Digest"
}
