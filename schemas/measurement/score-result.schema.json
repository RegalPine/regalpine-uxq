{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uxq.dev/schemas/measurement/score-result/1.0.0",
  "title": "ScoreResult",
  "allOf": [
    {
      "$ref": "#/$defs/BaseRecord"
    },
    {
      "$ref": "#/$defs/ScoreValue"
    }
  ],
  "type": "object",
  "unevaluatedProperties": false,
  "properties": {
    "runId": {
      "$ref": "#/$defs/Id"
    },
    "metricResultId": {
      "$ref": "#/$defs/Id"
    },
    "metricId": {
      "$ref": "#/$defs/Id"
    },
    "policyId": {
      "$ref": "#/$defs/Id"
    },
    "policyVersion": {
      "$ref": "#/$defs/Version"
    },
    "weight": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "calculatedAt": {
      "$ref": "#/$defs/Timestamp"
    }
  },
  "required": [
    "runId",
    "metricResultId",
    "metricId",
    "policyId",
    "policyVersion",
    "weight",
    "calculatedAt"
  ],
  "$defs": {
    "ScoreValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "SCORED"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "NOT_SCORED",
                "INSUFFICIENT_INPUTS",
                "CALCULATION_FAILED"
              ]
            },
            "reason": {
              "$ref": "#/$defs/Text"
            }
          },
          "required": [
            "status",
            "reason"
          ]
        }
      ]
    },
    "ScoreStatus": {
      "enum": [
        "SCORED",
        "NOT_SCORED",
        "INSUFFICIENT_INPUTS",
        "CALCULATION_FAILED"
      ]
    }
  }
}
